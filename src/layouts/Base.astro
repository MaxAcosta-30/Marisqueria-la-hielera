---
import '../styles/global.css';
import fuenteDisplay from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import { negocio } from '../data/negocio';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = `${negocio.nombre} · Mariscos en ${negocio.ciudad}`,
  descripcion = `${negocio.lema} Menú con precios y pedidos por WhatsApp.`,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0b3a53" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fuenteDisplay} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    {negocio.demo && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
