---
// Caso 5: confianza. En la muestra no se inventan opiniones: queda el espacio marcado para las reseñas reales.
import { negocio } from '../data/negocio';
const google = negocio.resenas.google;
---

<section class="resenas" aria-labelledby="resenas-titulo">
  <h2 id="resenas-titulo">Lo que dicen</h2>
  <div class="espacio">
    <svg class="estrellas" viewBox="0 0 88 16" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((i) => (
        <path transform={`translate(${i * 18} 0)`} d="M8 .8l2.2 4.6 5 .7-3.6 3.5.9 5L8 12.2l-4.5 2.4.9-5L.8 6.1l5-.7Z" />
      ))}
    </svg>
    <p class="texto">Aquí van las reseñas de Google del negocio.</p>
    {google
      ? <a class="ver" href={google} target="_blank" rel="noopener">Ver reseñas en Google</a>
      : <p class="nota">Se conectan con el perfil real del negocio.</p>}
  </div>
</section>

<style>
  .resenas {
    display: grid;
    gap: var(--e-4);
    padding-block: var(--e-4) var(--e-6);
  }
  h2 { font-size: var(--t-xl); }

  .espacio {
    display: grid;
    justify-items: start;
    gap: var(--e-2);
    max-width: 34rem;
    padding: var(--e-4);
    border: 2px dashed rgb(242 247 245 / 0.32);
    border-radius: var(--r-m);
  }
  /* Contorno, no relleno: todavía no hay calificación que mostrar. */
  .estrellas {
    width: 5.5rem;
    fill: none;
    stroke: var(--c-texto-suave);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .texto {
    font-family: var(--f-display);
    font-stretch: 85%;
    font-weight: 700;
    font-size: var(--t-l);
    line-height: 1.15;
  }
  .nota {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--c-texto-suave);
  }
  .ver {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 64rem) {
    .resenas { grid-template-columns: 11rem minmax(0, 1fr); gap: var(--e-5); align-items: start; }
    h2 { font-size: var(--t-l); font-stretch: 85%; padding-top: var(--e-3); }
  }
</style>
